{
  "manifest_version": 3,
  "name": "LeadSeed",
  "version": "1.0.0",
  "description": "Gestiona leads, envía WhatsApp y correos electrónicos",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["sidePanel", "storage", "notifications", "alarms"],
  "host_permissions": ["https://wa.me/*", "https://api.emailjs.com/*", "https://api.resend.com/*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; img-src 'self' data: https: http: blob:;"
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "background": {
    "service_worker": "src/background.ts",
    "type": "module"
  },
  "action": {
    "default_title": "Abrir Leads CRM"
  }
}
